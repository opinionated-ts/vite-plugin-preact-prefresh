{
  "name": "vite-plugin-preact-prefresh",
  "description": "A lightweight Prefresh plugin for Vite and Preact",
  "homepage": "https://github.com/opinionated-ts/vite-plugin-preact-prefresh#readme",
  "bugs": {
    "url": "https://github.com/opinionated-ts/vite-plugin-preact-prefresh/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Opinionated TS",
    "url": "https://github.com/opinionated-ts"
  },
  "contributors": [
    {
      "name": "Daniel A. Hernández Ochoa",
      "url": "https://github.com/DanhezCode"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/vite-plugin-preact-prefresh.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check . 1>/dev/null || oxfmt --check .",
    "fmt:fix": "oxfmt . 1>/zdev/null || oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "tests": "vitest run",
    "tests:watch": "vitest",
    "tests:cov": "vitest run --coverage",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@ampproject/remapping": "2.3.0",
    "@rollup/pluginutils": "5.4.0",
    "magic-string": "1.2.1",
    "oxc-transform": "0.146.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "awesome-config": "3.0.1",
    "tsdown": "0.22.14",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "bun": "1.3.14",
    "node": "26.7.0"
  },
  "packageManager": "bun@1.3.14"
}
